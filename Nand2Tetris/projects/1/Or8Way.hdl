/**
 * 8-way Or gate: 
 * out = in[0] Or in[1] Or ... Or in[7]
 */
CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    Or(a=in[0], b=in[1], out=True01);
    Or(a=True01, b=in[2], out=True2);
    Or(a=True2, b=in[3], out=True3);
    Or(a=True3, b=in[4], out=True4);
    Or(a=True4, b=in[5], out=True5);
    Or(a=True5, b=in[6], out=True6);
    Or(a=True6, b=in[7], out=out);
}